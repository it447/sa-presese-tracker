{
  "version": 2,
  "buildCommand": "cd backend && npm install && npx prisma generate && npx prisma migrate deploy && cd ../frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 512,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-calendar",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/process-meetings",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 21 * * 5"
    }
  ]
}
